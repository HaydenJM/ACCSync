<Window x:Class="ACCSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACCSync" Height="350" Width="480"
        Style="{StaticResource ModernWindowStyle}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Top">
            <!-- Title -->
            <TextBlock Text="ACCSync" Style="{StaticResource TitleLabelStyle}"/>

            <!-- Status Label -->
            <TextBlock x:Name="StatusLabel"
                       Text="Ready to sync"
                       Style="{StaticResource StatusLabelStyle}"
                       Foreground="#107C10"/>

            <!-- Progress Bar -->
            <ProgressBar x:Name="ProgressBar"
                         Height="6"
                         Margin="0,0,0,10"
                         Background="#E8E8E8"
                         Foreground="#0078D4"
                         Value="0"/>

            <!-- Progress Text -->
            <TextBlock x:Name="ProgressText"
                       Text=""
                       Style="{StaticResource StatusLabelStyle}"
                       Margin="0,0,0,15"
                       Foreground="#666666"/>

            <!-- Sync Button -->
            <Button x:Name="SyncButton"
                    Content="Start Sync"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="SyncButton_Click"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,15"/>

            <!-- Info Label -->
            <TextBlock x:Name="InfoLabel"
                       Style="{StaticResource InfoLabelStyle}"/>
        </StackPanel>
    </Grid>
</Window>
